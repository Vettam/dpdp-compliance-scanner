{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^DPDP-C-\\d{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "certainty": {
      "type": "string",
      "enum": [
        "settled",
        "arguable",
        "open"
      ]
    },
    "enforceable_from": {
      "type": "string"
    },
    "observable": {
      "type": "boolean"
    },
    "provisions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "KIDS",
          "3PF",
          "PROC",
          "XFER",
          "DEC",
          "SENS",
          "FP",
          "PRE",
          "PII-LEAK"
        ]
      },
      "default": []
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "C0",
          "C1",
          "C2",
          "C3",
          "C4",
          "C5",
          "C6",
          "C7",
          "C8",
          "C9",
          "C10",
          "UNCLASSIFIED"
        ]
      },
      "default": []
    },
    "owner": {
      "type": "string",
      "enum": [
        "engineering",
        "marketing",
        "counsel",
        "product"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "page",
          "code",
          "database"
        ]
      },
      "default": [
        "page"
      ]
    },
    "penalty_band": {
      "type": "string"
    },
    "detection": {
      "type": "object",
      "properties": {
        "match": {
          "type": "string",
          "enum": [
            "request",
            "banner",
            "cookie",
            "storage",
            "api_call",
            "embed",
            "meta",
            "data_point",
            "recipient",
            "consent_gate",
            "map"
          ]
        },
        "where": {
          "type": "object",
          "properties": {
            "tracker_category": {
              "type": "string",
              "enum": [
                "C0",
                "C1",
                "C2",
                "C3",
                "C4",
                "C5",
                "C6",
                "C7",
                "C8",
                "C9",
                "C10",
                "UNCLASSIFIED"
              ]
            },
            "tracker_categories": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "C0",
                  "C1",
                  "C2",
                  "C3",
                  "C4",
                  "C5",
                  "C6",
                  "C7",
                  "C8",
                  "C9",
                  "C10",
                  "UNCLASSIFIED"
                ]
              }
            },
            "tracker_flags": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "KIDS",
                  "3PF",
                  "PROC",
                  "XFER",
                  "DEC",
                  "SENS",
                  "FP",
                  "PRE",
                  "PII-LEAK"
                ]
              }
            },
            "before_banner_detected": {
              "type": "boolean"
            },
            "before_first_paint": {
              "type": "boolean"
            },
            "banner_detected": {
              "type": "boolean"
            },
            "has_accept": {
              "type": "boolean"
            },
            "has_reject": {
              "type": "boolean"
            },
            "has_settings": {
              "type": "boolean"
            },
            "has_pre_ticked": {
              "type": "boolean"
            },
            "has_language_switcher": {
              "type": "boolean"
            },
            "mentions_legitimate_interest": {
              "type": "boolean"
            },
            "implies_consent_by_browsing": {
              "type": "boolean"
            },
            "page_language": {
              "type": "string"
            },
            "gpc_sent": {
              "type": "boolean"
            },
            "is_third_party": {
              "type": "boolean"
            },
            "destination_country": {
              "type": "string"
            },
            "destination_country_not": {
              "type": "string"
            },
            "cookie_name": {
              "type": "string"
            },
            "cookie_insecure": {
              "type": "boolean"
            },
            "first_party": {
              "type": "boolean"
            },
            "api": {
              "type": "string"
            },
            "embed_kind": {
              "type": "string",
              "enum": [
                "iframe",
                "script",
                "img",
                "font"
              ]
            },
            "sri": {
              "type": "boolean"
            },
            "basis": {
              "type": "string",
              "enum": [
                "consent",
                "voluntarily_provided",
                "legal_obligation",
                "medical_emergency",
                "employment",
                "state_function",
                "unstated"
              ]
            },
            "category_in": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "C0",
                  "C1",
                  "C2",
                  "C3",
                  "C4",
                  "C5",
                  "C6",
                  "C7",
                  "C8",
                  "C9",
                  "C10",
                  "UNCLASSIFIED"
                ]
              }
            },
            "source_kind": {
              "type": "string",
              "enum": [
                "page",
                "code",
                "database"
              ]
            },
            "category": {
              "type": "string",
              "enum": [
                "C0",
                "C1",
                "C2",
                "C3",
                "C4",
                "C5",
                "C6",
                "C7",
                "C8",
                "C9",
                "C10",
                "UNCLASSIFIED"
              ]
            },
            "category_absent": {
              "type": "string",
              "enum": [
                "C0",
                "C1",
                "C2",
                "C3",
                "C4",
                "C5",
                "C6",
                "C7",
                "C8",
                "C9",
                "C10",
                "UNCLASSIFIED"
              ]
            },
            "flags_any": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "KIDS",
                  "3PF",
                  "PROC",
                  "XFER",
                  "DEC",
                  "SENS",
                  "FP",
                  "PRE",
                  "PII-LEAK"
                ]
              }
            },
            "basis_not": {
              "type": "string",
              "enum": [
                "consent",
                "voluntarily_provided",
                "legal_obligation",
                "medical_emergency",
                "employment",
                "state_function",
                "unstated"
              ]
            },
            "consent_gate_present": {
              "type": "boolean"
            },
            "consent_gate_kind": {
              "type": "string",
              "enum": [
                "banner",
                "checkbox",
                "dialog",
                "code_check"
              ]
            },
            "retention_stated": {
              "type": "boolean"
            },
            "retention_signal_any": {
              "type": "boolean"
            },
            "recipient_role": {
              "type": "string",
              "enum": [
                "processor",
                "fiduciary",
                "depends_on_configuration",
                "independent_or_joint_fiduciary",
                "processor_or_3pf"
              ]
            },
            "recipient_country_not": {
              "type": "string"
            },
            "rights_endpoint_present": {
              "type": "object",
              "properties": {
                "right": {
                  "type": "string",
                  "enum": [
                    "access",
                    "erase",
                    "correct"
                  ]
                },
                "present": {
                  "type": "boolean"
                }
              },
              "required": [
                "right",
                "present"
              ],
              "additionalProperties": false
            },
            "observation_kind": {
              "type": "string",
              "enum": [
                "cookie",
                "storage_key",
                "request",
                "api_call",
                "embed",
                "banner",
                "package",
                "http_call",
                "schema_column",
                "input_field",
                "consent_gate",
                "retention_signal",
                "rights_endpoint"
              ]
            },
            "notice_itemisation": {
              "type": "boolean"
            },
            "mentions_grievance": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "match",
        "where"
      ],
      "additionalProperties": false
    },
    "needs_input": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "prompt": {
      "type": "string"
    },
    "detection_confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "rationale_plain": {
      "type": "string",
      "minLength": 1
    },
    "rationale_dev": {
      "type": "string",
      "minLength": 1
    },
    "remediation_summary": {
      "type": "string",
      "default": ""
    },
    "explainer_url": {
      "type": "string",
      "format": "uri"
    },
    "since": {
      "type": "string"
    },
    "changelog": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "version",
          "date",
          "note"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "title",
    "certainty",
    "enforceable_from",
    "observable",
    "provisions",
    "owner",
    "penalty_band",
    "detection",
    "rationale_plain",
    "rationale_dev",
    "explainer_url",
    "since",
    "changelog"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
