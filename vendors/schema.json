{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "vendor": {
      "type": "string",
      "minLength": 1
    },
    "match": {
      "type": "object",
      "properties": {
        "cookies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "storage_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "packages": {
      "type": "object",
      "properties": {
        "npm": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "pypi": {
          "$ref": "#/properties/packages/properties/npm"
        },
        "maven": {
          "$ref": "#/properties/packages/properties/npm"
        },
        "go": {
          "$ref": "#/properties/packages/properties/npm"
        },
        "rubygems": {
          "$ref": "#/properties/packages/properties/npm"
        },
        "cocoapods": {
          "$ref": "#/properties/packages/properties/npm"
        },
        "cargo": {
          "$ref": "#/properties/packages/properties/npm"
        },
        "composer": {
          "$ref": "#/properties/packages/properties/npm"
        },
        "pub": {
          "$ref": "#/properties/packages/properties/npm"
        },
        "swift": {
          "$ref": "#/properties/packages/properties/npm"
        }
      },
      "additionalProperties": false
    },
    "data_points": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "category": {
      "type": "string",
      "enum": [
        "C0",
        "C1",
        "C2",
        "C3",
        "C4",
        "C5",
        "C6",
        "C7",
        "C8",
        "C9",
        "C10",
        "UNCLASSIFIED"
      ]
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "KIDS",
          "3PF",
          "PROC",
          "XFER",
          "DEC",
          "SENS",
          "FP",
          "PRE",
          "PII-LEAK"
        ]
      },
      "default": []
    },
    "role": {
      "type": "string",
      "enum": [
        "processor",
        "fiduciary",
        "depends_on_configuration",
        "independent_or_joint_fiduciary",
        "processor_or_3pf"
      ]
    },
    "lawful_basis": {
      "type": "string",
      "enum": [
        "consent",
        "s7a",
        "none",
        "mixed"
      ]
    },
    "provisions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "notice_itemisation": {
      "type": "string"
    },
    "destination_countries": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "fires_pre_consent_by_default": {
      "type": "boolean",
      "default": false
    },
    "withdrawal_mechanism": {
      "type": "string",
      "default": ""
    },
    "last_verified": {
      "type": "string"
    },
    "provenance": {
      "type": "string",
      "default": "direct observation"
    },
    "cmp": {
      "type": "object",
      "properties": {
        "selectors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "accept_selectors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "reject_selectors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        }
      },
      "required": [
        "selectors"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "vendor",
    "match",
    "category",
    "role",
    "lawful_basis",
    "provisions",
    "notice_itemisation",
    "last_verified"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
